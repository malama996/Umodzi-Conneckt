          ]
        },
        {
          "name": "Technicians nearby",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/technicians/nearby?latitude=-12.8162&longitude=28.1995&radius=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "technicians",
                "nearby"
              ],
              "query": [
                {
                  "key": "latitude",
                  "value": "-12.8162"
                },
                {
                  "key": "longitude",
                  "value": "28.1995"
                },
                {
                  "key": "radius",
                  "value": "50"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Classify a fault description",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"The kitchen tap is leaking badly and the pipe under the sink is wet\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/classify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "classify"
              ]
            }
