          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('classified as plumbing', () => pm.expect(JSON.stringify(pm.response.json()).toLowerCase()).to.include('plumbing'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Requests and offers",
      "item": [
        {
          "name": "Customer creates a request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Burst pipe under the kitchen sink, water everywhere\",\n  \"category\": \"Plumbing\",\n  \"city\": \"Kitwe\",\n  \"clientRequestId\": \"postman-{{$timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.environment.set('requestId', b.data.id);",
                  "pm.test('status is pending or matching', () => pm.expect(['pending', 'matching']).to.include(b.data.status));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the request back",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests",
                "{{requestId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('same request id', () => pm.expect(pm.response.json().data.id).to.eql(pm.environment.get('requestId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Other customer cannot read it",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{technicianToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests",
                "{{requestId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 for a non-participant', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Dispatch created an offer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}/offers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests",
                "{{requestId}}",
                "offers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const offers = pm.response.json().data;",
                  "pm.test('dispatch produced at least one offer', () => pm.expect(offers.length).to.be.above(0));",
                  "if (offers.length) { pm.environment.set('offerId', offers[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate offer is refused",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"{{requestId}}\",\n  \"technicianId\": \"{{anyTechnicianId}}\",\n  \"candidateIndex\": 0,\n  \"status\": \"pending\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/offers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "offers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 when an offer already exists for this request', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid status is rejected",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"teleported\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "requests",
                "{{requestId}}",
                "status"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 for unknown status', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
