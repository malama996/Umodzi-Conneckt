# Umodzi Connect backend — environment template (copy to .env, fill in).
# Never commit a real .env; never commit real secrets.

# --- Database (PostgreSQL/PostGIS) -----------------------------------------
# Production target is Supabase PostgreSQL/PostGIS. Provide the Supabase
# connection string (pooler or direct) here; credentials stay server-side and
# are NEVER exposed to the frontend.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/umodzi

# Separate migration URL (Task 36): Use an administrator role ONLY for
# migrations, never for runtime. Leave unset to use DATABASE_URL for both.
# MIGRATIONS_DATABASE_URL=postgresql://admin:admin@localhost:5432/umodzi

# SSL configuration for production databases (Supabase): append
#   ?sslmode=verify-full&sslrootcert=supabase-ca.pem
# to BOTH DATABASE_URL and MIGRATIONS_DATABASE_URL, with Supabase's CA
# (downloaded from Dashboard → Project Settings → Database → SSL
# Configuration) saved as backend/supabase-ca.pem and committed to the repo.
# verify-full WITHOUT the CA crashes at boot with SELF_SIGNED_CERT_IN_CHAIN
# (Supabase's chain uses its own private CA); pg >= 8.16 treats
# sslmode=require as an alias for verify-full, so it does NOT avoid this.
# A missing CA file crashes with ENOENT. Localhost needs no SSL parameters.
PORT=3001
# Runtime mode. Production hardening (real SMS/push providers, strict error
# masking) keys off this. Use "production" when deployed.
NODE_ENV=development
# CORS allow-list (Task 28 §14). Explicit origins only — never "*".
# Comma-separate multiple production origins, e.g.
#   FRONTEND_ORIGIN=https://app.example.com,https://admin.example.com
FRONTEND_ORIGIN=http://localhost:3000
# Set these on a hosted API behind a TLS-terminating proxy. For a Netlify
# frontend on a different site, use COOKIE_SAME_SITE=none; where the frontend
# and API are sibling subdomains of one custom domain, lax is preferable.
TRUST_PROXY=false
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Authentication (Task 23) ----------------------------------------------
# REQUIRED. HS256 secret for access tokens, min 32 chars.
# Generate with e.g.:  openssl rand -hex 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
# Optional claim fencing (defaults shown).
JWT_ISSUER=umodzi-connect-api
JWT_AUDIENCE=umodzi-connect-web
# Access token lifetime (short-lived; default 15m). Supports s/m/h/d units.
ACCESS_TOKEN_TTL=15m
# Refresh-token session lifetime (default 7d).
REFRESH_TOKEN_TTL=7d

# --- Password recovery (audit §3) ------------------------------------------
# Recovery links are emailed through the Resend HTTP API. All three are
# SERVER-ONLY — never copy them into NEXT_PUBLIC_*. Without RESEND_API_KEY
# and RESEND_FROM_EMAIL the recovery endpoint still answers safely but no
# email is sent (in non-production the link is printed to the server console
# for local testing; it is NEVER logged in production).
#RESEND_API_KEY=
#RESEND_FROM_EMAIL=Umodzi Connect <no-reply@yourdomain.com>
# Recovery link origin. Reuses the existing FRONTEND_ORIGIN when set;
# PUBLIC_APP_URL is an optional alias (defaults to http://localhost:3000).
#PUBLIC_APP_URL=http://localhost:3000
# Recovery link lifetime (single-use). Default 30m. Supports s/m/h/d units.
#PASSWORD_RESET_TTL=30m

# --- Controlled administrator seed (Task 23) --------------------------------
# If BOTH are set, an administrator account is created on startup when
# missing (the password is hashed with argon2id and never logged).
# Public registration can never create administrators.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- File storage (Task 26) -------------------------------------------------
# Server-local root for uploaded profile photos + verification documents.
# Only opaque storage KEYS are ever recorded in the database — this path is
# operational config, never exposed to clients. Default: var/uploads
# (relative to the backend working directory).
STORAGE_DIR=var/uploads

# Storage provider: `local` (default) or `supabase`.
#   local    = STORAGE_DIR above. On platforms with EPHEMERAL disks (Render,
#              Vercel, …) every redeploy/restart DELETES stored files — local
#              is for development and disposable demos only.
#   supabase = durable Supabase Storage via its REST API. Requires all four
#              SUPABASE_* vars below; the server FAILS FAST at boot if
#              STORAGE_PROVIDER=supabase and any of them are missing.
# Bucket routing: keys under verification/ → private bucket, everything else
# (profile photos) → public bucket. Create both buckets in the Supabase
# Dashboard → Storage first.
STORAGE_PROVIDER=local
# SUPABASE_URL=https://PROJECT-REF.supabase.co
# SUPABASE_STORAGE_KEY=   # a NEW service-role key minted for THIS app only;
#                         # never shipped to the browser, never logged.
#                         # Rotate any old/exposed key before enabling.
# SUPABASE_PUBLIC_BUCKET=profile-photos
# SUPABASE_PRIVATE_BUCKET=verification-docs

# --- Rate limiting (Task 28 §13) --------------------------------------------
# Per-route limits (requests per window). The auth endpoints (login/register)
# have their own stricter limiter in auth/routes.ts. Defaults are generous so
# legitimate users and the automated regression suites are never throttled;
# lower them for production as desired. Leave unset to use the shown default.
RATE_LIMIT_WINDOW=1 minute
# RATE_LIMIT_OFFERS=60          # POST /api/v1/offers (default 60)
# RATE_LIMIT_UPLOADS=60         # photo + verification document uploads (default 60)
# RATE_LIMIT_REVIEWS=60         # POST /api/v1/requests/:id/review (default 60)
# RATE_LIMIT_VERIFICATION=20    # POST /api/v1/technician/verification/submit (default 20)
# RATE_LIMIT_ADMIN=60           # sensitive admin actions (default 60)

# --- Offer eligibility / service radius (Task 28 §6) -------------------------
# Optional. When set to a positive number of kilometres, POST /offers also
# enforces a PostGIS ST_Distance cap between the request and the technician
# ON TOP OF the canonical city/service-area match. Requires the request to
# carry coordinates; API-created requests currently do not, so the city match
# remains the operative rule. Leave unset to enforce city match only.
# MAX_SERVICE_RADIUS_KM=50

# --- Dispatch engine (Task 36, Stages 4–5) ------------------------------------
# All values are backend-only operational knobs; leave unset to use defaults.
# Max concurrent assignments (accepted offers on matched/in_progress requests)
# one technician may hold before dispatch stops offering them work. Default 3.
#MAX_ACTIVE_ASSIGNMENTS_PER_TECHNICIAN=3
# Minutes a pending offer waits for a response before the sweeper closes it
# and offers the next ranked candidate. Default 15.
#DISPATCH_OFFER_TIMEOUT_MINUTES=15
# Sweeper cadence in milliseconds (minimum 15000). Default 60000.
#DISPATCH_SWEEP_INTERVAL_MS=60000
# Minutes a no_match request waits before the waiting-queue sweep retries
# dispatch. Default 30.
#DISPATCH_WAITING_RETRY_MINUTES=30
# Hours after creation after which a no_match request is never auto-retried
# again (the customer can still use POST /requests/:id/retry). Default 72.
#DISPATCH_WAITING_MAX_AGE_HOURS=72

# --- SMS via Africa's Talking (Task 28.2F) ---------------------------------
# First production SMS provider. The provider implementation stays behind
# the ISmsProvider boundary (see src/notifications/notificationService.ts),
# so Twilio/custom providers remain drop-in replacements.
# Values are backend-only: NEVER copy them into NEXT_PUBLIC_* or frontend
# code, and they are never logged.
#SMS_PROVIDER=africas_talking
#AFRICASTALKING_USERNAME=
#AFRICASTALKING_API_KEY=
#AFRICASTALKING_FROM=Umodzi
# Policy: SMS is reserved for action-required outcomes only (accepted
# offers, verification approvals/rejections — see isSmsEligibleEvent).
# Web Push + in-app stay the primary channels. No phone numbers are stored
# on users yet, so no route sends SMS today; credential-dependent delivery
# remains unverified until sender credentials + recipient numbers exist.

# --- Gemini AI fault classification (Task 33) ---------------------------------
# Server-side classification of customer fault descriptions into the nine
# canonical service categories (POST /api/v1/classify-fault). All values are
# backend-only: NEVER copy them into NEXT_PUBLIC_* or frontend code, and the
# key is never logged or returned to clients.
# Provision the key at https://aistudio.google.com/apikey (free tier).
#GEMINI_API_KEY=
# Model override (default: gemini-2.0-flash, a long-standing free-tier Flash
# model). If Google retires it, set a supported Flash model here, e.g.
#GEMINI_MODEL=gemini-2.0-flash
# Provider timeout in ms (default 12000). One attempt per request, no retries.
#GEMINI_TIMEOUT_MS=12000
# Per-route limit for POST /api/v1/classify-fault (default 20/minute).
# RATE_LIMIT_CLASSIFY=20          # AI classification (default 20)

# --- Demo data ---------------------------------------------------------------
# Leave false in staging/production. Set true only for disposable local demos.
SEED_DEMO_DATA=false

# --- Web Push VAPID (Task 28.2A/2D6) ----------------------------------------
# Real VAPID credentials for the web-push provider. The PUBLIC key is also
# baked into the frontend bundle (NEXT_PUBLIC_VAPID_PUBLIC_KEY); the
# PRIVATE key stays here, backend-only, and must NEVER be copied anywhere
# else. Generate with the web-push package (generateVAPIDKeys) or:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#VAPID_SUBJECT=mailto:you@example.com
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
