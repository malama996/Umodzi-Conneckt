# ============================================================================
# Render dashboard environment template — backend (umodzi-backend)
# ============================================================================
# Set these in: Render Dashboard → your service → Environment
# (Sec
# --- Required: runtirets show as `sync: false` in render.yaml — they are entered here,
#  never committed anywhere.)
#
# Generate a JWT secret with:   openssl rand -hex 32
#
# BUILD & INSTALL COMMANDS — required if the service was created manually in
# the dashboard instead of syncing render.yaml (service → Build & Deploy):
#   Install Command: npm ci --include=dev
#   Build Command:   npm run build -w backend
# --include=dev is NOT optional: with NODE_ENV=production set below, npm skips
# devDependencies at build time (typescript, @types/node, @types/pg) and the
# build dies with TS2591 "Cannot find name 'process'" errors.
me -------------------------------------------------------
NODE_ENV=production
NODE_VERSION=20

# --- Required: database + TLS (Supabase) ------------------------------------
# Both URLs use sslmode=verify-full WITH Supabase's CA certificate:
#   sslrootcert=supabase-ca.pem  (path relative to backend/, where the server
#   runs). Supabase's certificate chain is signed by Supabase's OWN CA, which
#   Node.js does not trust by default — verify-full WITHOUT this file crashes
#   the server at boot with `SELF_SIGNED_CERT_IN_CHAIN`.
#
# ONE-TIME SETUP (before the first deploy — the deploy fails without it):
#   1. Supabase Dashboard → Project Settings → Database → SSL Configuration
#      → download the CA certificate (prod-ca-2021.crt).
#   2. Save it as backend/supabase-ca.pem in the repo and COMMIT it —
#      a CA certificate is public information, never a secret.
#   3. Keep `&sslrootcert=supabase-ca.pem` on BOTH URLs below.
#
# Do NOT "fix" a missing-file boot crash by switching to sslmode=require:
# in pg >= 8.16, require is an alias for verify-full and fails identically
# (tested against the exact pg version this app ships).

# Restricted runtime role (pooler connection, port 6543)
DATABASE_URL=postgresql://umodzi_app:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=supabase-ca.pem
# Administrator role — DDL only; the server runs pending migrations with this
# at boot, BEFORE serving traffic. Never use it for runtime traffic.
MIGRATIONS_DATABASE_URL=postgresql://postgres:ADMIN_PASSWORD@db.REGION.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=supabase-ca.pem

# HS256, min 32 chars — openssl rand -hex 32
JWT_SECRET=

# Your Netlify site — exact origin, no trailing slash. CORS allow-list; the
# backend refuses to boot in production if this is unset.
FRONTEND_ORIGIN=https://YOUR-SITE.netlify.app

# Seeded administrator account (created at boot when missing)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# --- Required: cross-domain cookie auth + proxy ------------------------------
# Render terminates TLS before Node: without TRUST_PROXY the rate limiter
# sees Render's proxy IP as every client's IP (all users share one bucket).
TRUST_PROXY=true
# Backend FAILS FAST at boot in production without COOKIE_SECURE=true.
COOKIE_SECURE=true
# frontend (netlify.app) and backend (onrender.com) are different sites —
# with the default `lax`, the HttpOnly refresh cookie is silently dropped on
# cross-origin /auth/refresh calls and login appears to "not stick".
COOKIE_SAME_SITE=none

# --- File uploads ------------------------------------------------------------
# local    = server disk. EPHEMERAL on Render: profile photos and
#            verification documents are LOST on every redeploy/restart.
#            Acceptable only for demos.
# supabase = durable object storage (RECOMMENDED for production) — requires
#            the four SUPABASE_* variables below.
STORAGE_DIR=var/uploads
STORAGE_PROVIDER=local

# Required when STORAGE_PROVIDER=supabase (the server refuses to boot if
# STORAGE_PROVIDER=supabase and any of these are missing):
#   1. Supabase Dashboard → Storage → create bucket `profile-photos` (public)
#      and bucket `verification-docs` (private).
#   2. Project Settings → API Keys → create a NEW service role key for this
#      app and paste it as SUPABASE_STORAGE_KEY. ROTATE the old service role
#      key first (see the warning in backend/.env).
# SUPABASE_URL=https://PROJECT-REF.supabase.co
# SUPABASE_STORAGE_KEY=
# SUPABASE_PUBLIC_BUCKET=profile-photos
# SUPABASE_PRIVATE_BUCKET=verification-docs

# --- Optional: rate limiting (defaults are generous) -------------------------
# RATE_LIMIT_WINDOW=1 minute
# RATE_LIMIT_OFFERS=60
# RATE_LIMIT_UPLOADS=60
# RATE_LIMIT_REVIEWS=60
# RATE_LIMIT_VERIFICATION=20
# RATE_LIMIT_ADMIN=60

# --- Optional: Web Push (VAPID) ----------------------------------------------
# Generate: node -e "console.log(require('web-push').generateVAPIDKeys())"
# The PUBLIC key must also be set in Netlify as NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# VAPID_SUBJECT=mailto:you@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- Optional: SMS (Africa's Talking) ----------------------------------------
# SMS_PROVIDER=africas_talking
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_FROM=Umodzi

# --- Optional: AI fault classification ---------------------------------------
# GEMINI_API_KEY=

# --- Optional: demo data (MUST stay false/absent in production) --------------
# SEED_DEMO_DATA=false

# ============================================================================
# Also NOT in Render: the GitHub Actions keep-alive workflow needs a repository
# variable (Settings → Secrets and variables → Actions → Variables):
#   RENDER_HEALTH_URL=https://YOUR-SERVICE.onrender.com/health
# ============================================================================
