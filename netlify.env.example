# ============================================================================
# Netlify dashboard environment template — frontend (Next.js)
# ============================================================================
# Set these in: Netlify Dashboard → Site configuration → Environment variables
# netlify.toml already sets NODE_VERSION, build command, publish directory and
# the @netlify/plugin-nextjs plugin; only the variables below belong in the
# dashboard.

# --- Required ----------------------------------------------------------------
# Backend API base — your Render service URL. Every frontend → API call goes
# through this (see frontend/lib/api/client.ts). Must include /api/v1 and must
# be https in production (no localhost).
NEXT_PUBLIC_API_BASE_URL=https://YOUR-SERVICE.onrender.com/api/v1

# --- Optional: Web Push ------------------------------------------------------
# PUBLIC VAPID key generated alongside the backend VAPID_* values
# (backend render.env.example). Baked into the bundle at build time.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ============================================================================
# Notes
# - NEXT_PUBLIC_* values are baked in at BUILD time: change → redeploy.
# - After deploying, set FRONTEND_ORIGIN on Render to this site's exact
#   origin (https://YOUR-SITE.netlify.app) or the backend will reject
#   cross-origin requests.
# - Also verify the GitHub repository variable RENDER_HEALTH_URL points at
#   https://YOUR-SERVICE.onrender.com/health (Actions keep-alive workflow).
# ============================================================================
