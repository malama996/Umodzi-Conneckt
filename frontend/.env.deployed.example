# ─── Umodzi Connect frontend — DEPLOYED SYSTEM ──────────────────────────────
# Copy to frontend/.env.local when you want the local UI to talk to the
# deployed API instead of localhost. Replace the host with your live API.
#
# The URL MUST end in /api/v1 and must be served over https, because the
# backend refuses to set cookies for a cross-site http origin.
NEXT_PUBLIC_API_BASE_URL=https://your-api-host.example.com/api/v1
# Paste the SAME public VAPID key the backend is configured with, or leave blank
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
