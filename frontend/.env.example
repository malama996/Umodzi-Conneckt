# Umodzi Connect frontend — environment template (copy to .env.local).
# NEXT_PUBLIC_* values are baked in at BUILD time — restart `npm run dev`
# (or rebuild) after changing them.

# Backend API base used by lib/api/client.ts (Task 23 auth endpoints live
# under this base: /auth/register, /auth/login, /auth/refresh, /auth/logout,
# /auth/me). Credentialed requests include the HttpOnly refresh cookie, so
# this origin must match the backend's FRONTEND_ORIGIN allow-list entry.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Web Push VAPID PUBLIC key used by lib/push/webPush.ts (Task 28.2C).
# PUBLIC key only — it is baked into the browser bundle. The VAPID PRIVATE
# key stays backend-only (backend .env) and must NEVER be copied here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
